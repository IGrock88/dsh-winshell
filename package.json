{
  "name": "dsh-winshell",
  "version": "1.0.4",
  "description": "DSH plugin (Windows): one shell tool across PowerShell, Git Bash and WSL, plus persistent terminal sessions.",
  "author": "IGrock88",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGrock88/dsh-winshell.git"
  },
  "bugs": {
    "url": "https://github.com/IGrock88/dsh-winshell/issues"
  },
  "homepage": "https://github.com/IGrock88/dsh-winshell#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "winshell",
    "plugin",
    "terminal",
    "shell",
    "powershell",
    "git-bash",
    "wsl",
    "windows"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node test/unit.mjs && node test/apply.mjs && node test/buffer.mjs && node test/terminal.mjs && node test/settle.mjs && node test/e2e.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-shell": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.5-rc.1 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
